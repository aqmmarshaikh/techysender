rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ── Transfer Documents ──
    match /transfers/{transferId} {
      allow read: if true;
      
      allow create: if request.resource.data.keys().hasAll([
        'transferId', 'mode', 'status', 'files', 'totalSize',
        'createdAt', 'expiresAt', 'downloadCount', 'viewCount', 'storagePath'
      ])
      && request.resource.data.totalSize <= 200 * 1024 * 1024
      && request.resource.data.expiresAt is timestamp
      && request.resource.data.downloadCount == 0
      && request.resource.data.viewCount == 0;
      
      allow update: if (
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewCount'])
          && request.resource.data.viewCount == resource.data.viewCount + 1)
        ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['downloadCount'])
          && request.resource.data.downloadCount == resource.data.downloadCount + 1)
        ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status in ['EXPIRED', 'COMPLETED', 'CANCELLED'])
      );
      
      // Secure delete: Only allow deletion if document has expired or is in terminal state (EXPIRED, COMPLETED, CANCELLED)
      allow delete: if resource.data.expiresAt <= request.time
        || resource.data.status in ['EXPIRED', 'COMPLETED', 'CANCELLED'];
    }
    
    // ── WebRTC Signaling Documents ──
    match /signaling/{sessionId} {
      allow read, create, update: if true;
      // Secure delete: Restrict deletion to terminal states (disconnected, completed, failed, cancelled, EXPIRED) or TTL expiration
      allow delete: if resource.data.expiresAt <= request.time
        || resource.data.status in ['disconnected', 'completed', 'failed', 'cancelled', 'EXPIRED'];
      
      match /callerCandidates/{candidateId} {
        allow read, create, delete: if true;
      }
      
      match /calleeCandidates/{candidateId} {
        allow read, create, delete: if true;
      }
    }
    
    // ── Short Links Documents ──
    match /shortLinks/{shortCode} {
      allow read, create, update: if true;
      // Secure delete: Restrict deletion strictly to TTL expiration (resource.data.expiresAt <= request.time)
      allow delete: if resource.data.expiresAt <= request.time;
    }
    
    // Deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
